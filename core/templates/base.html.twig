{# Panel düzeni. Dış betik/stil yok: yönetim sayfasına üçüncü taraf kod girmez
   (tarifin şablonu sürümü sabitlenmemiş bir CDN betiği yüklüyordu). #}
<!DOCTYPE html>
<html lang="tr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="robots" content="noindex, nofollow">
        <title>{% block title %}MyWeb2Wave panel{% endblock %}</title>
        <style>
            :root { color-scheme: light dark; --kenar: #8884; --soluk: #888; --iyi: #1a7f37; --reklam: #9a6700; }
            body { font: 15px/1.45 system-ui, sans-serif; margin: 0 auto; padding: 16px; max-width: 1100px; }
            h1 { font-size: 20px; margin: 0; }
            header { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
            nav a { margin-right: 10px; }
            .kartlar { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; margin-bottom: 20px; }
            .kart { border: 1px solid var(--kenar); border-radius: 8px; padding: 12px; }
            .kart h2 { font-size: 14px; margin: 0 0 8px; color: var(--soluk); font-weight: 600; }
            .kart dl { display: grid; grid-template-columns: 1fr auto; margin: 0; gap: 2px 12px; }
            .kart dd { margin: 0; text-align: right; font-variant-numeric: tabular-nums; }
            .tablo { overflow-x: auto; }
            table { border-collapse: collapse; width: 100%; font-size: 14px; }
            th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--kenar); white-space: nowrap; }
            th { color: var(--soluk); font-weight: 600; }
            .reklam { color: var(--reklam); font-weight: 600; }
            .odedi { color: var(--iyi); font-weight: 600; }
            .soluk { color: var(--soluk); }
            form.giris { max-width: 320px; margin: 15vh auto 0; display: grid; gap: 10px; }
            form.giris input, form.giris button { font: inherit; padding: 8px; }
            .hata { color: #cf222e; }
            .bildirim { padding: 8px 12px; border-radius: 6px; border: 1px solid var(--kenar); }
            .bildirim.tamam { border-color: var(--iyi); }
            .bildirim.hata { border-color: #cf222e; }
            .eylemler { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
            .eylemler form { margin: 0; }
            button.ana { background: #2563eb; color: #fff; border: 0; border-radius: 6px; padding: 8px 14px; font: inherit; cursor: pointer; }
            button:disabled { opacity: .5; cursor: not-allowed; }
            #duzenleyici fieldset { border: 1px solid var(--kenar); border-radius: 8px; margin: 12px 0; padding: 12px; }
            #duzenleyici legend { font-weight: 600; }
            #duzenleyici label { display: grid; gap: 2px; margin: 6px 0; font-size: 14px; }
            #duzenleyici input, #duzenleyici textarea, #duzenleyici select { font: inherit; padding: 6px; width: 100%; box-sizing: border-box; }
            #duzenleyici .satir { display: flex; gap: 6px; align-items: end; }
            #duzenleyici .satir label { flex: 1; }
            #duzenleyici .kimlik input { font-family: ui-monospace, monospace; font-size: 13px; }
            #duzenleyici .durum { position: sticky; bottom: 0; background: Canvas; padding: 8px 0; display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
            #duzenleyici .durum ul { flex-basis: 100%; margin: 0; padding-left: 20px; max-height: 30vh; overflow-y: auto; }
            #duzenleyici .durum ul:empty { display: none; }
        </style>
    </head>
    <body>
        {% block body %}{% endblock %}
    </body>
</html>
