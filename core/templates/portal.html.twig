{# M6b2: müşterinin portal onay sayfası — panel düzeni değil, dış betik / stil yok. #}
<!DOCTYPE html>
<html lang="tr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="robots" content="noindex, nofollow">
        <meta name="referrer" content="no-referrer">
        <title>Aboneliğinizi yönetin</title>
        <style>
            :root { color-scheme: light dark; --zemin: #f5f6f8; --yuzey: #fff; --metin: #111827; --soluk: #6b7280; --vurgu: #2563eb; --tehlike: #dc2626; }
            @media (prefers-color-scheme: dark) { :root { --zemin: #0b0d12; --yuzey: #141821; --metin: #e7e9ee; --soluk: #8b93a7; --vurgu: #5b8cff; --tehlike: #f87171; } }
            body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 16px; background: var(--zemin); color: var(--metin); font: 16px/1.5 system-ui, sans-serif; }
            main { max-width: 420px; width: 100%; background: var(--yuzey); border-radius: 14px; padding: 28px; }
            h1 { margin: 0 0 8px; font-size: 22px; }
            p { margin: 0 0 18px; color: var(--soluk); }
            .hata { color: var(--tehlike); }
            button, a.dugme { display: block; width: 100%; padding: 12px; border: 0; border-radius: 10px; background: var(--vurgu); color: #fff; font: inherit; font-weight: 600; text-align: center; text-decoration: none; cursor: pointer; }
        </style>
    </head>
    <body>
        <main>
            <h1>Aboneliğinizi yönetin</h1>
            {% if hata %}
                <p class="hata" role="alert">{{ hata }}</p>
                <a class="dugme" href="{{ yeniden }}">Yeni bağlantı iste</a>
            {% else %}
                <p>Kartınızı güncelleyebilir, aboneliğinizi dönem sonunda iptal edebilir ve faturalarınızı görebilirsiniz (Stripe).</p>
                <form method="post">
                    <button type="submit">Portalı aç</button>
                </form>
            {% endif %}
        </main>
    </body>
</html>
