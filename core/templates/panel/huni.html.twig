{% extends 'base.html.twig' %}

{% block title %}{{ uygulama }} hunisi · MyWeb2Wave panel{% endblock %}

{% block body %}
    {% include 'panel/_ust.html.twig' with {baslik: uygulama ~ ' hunisi'} %}

    <section class="eylemler">
        <a href="{{ onizleme }}" target="_blank" rel="noopener">Taslağı önizle ↗</a>
        <a href="{{ huni_adresi }}" target="_blank" rel="noopener">Yayındakini aç ↗</a>
        <form method="post" action="{{ path('panel_huni_yayinla', {app: uygulama}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('huni-' ~ uygulama) }}">
            <button type="submit" id="yayinla" class="ana">Yayınla{% if not farkli %} (değişiklik yok){% endif %}</button>
        </form>
    </section>
    <p class="soluk">Önizleme bağlantısı 1 saat geçerli; önce kaydet, sonra önizle. Yayın ziyaretçilere en geç 1 dakikada ulaşır.</p>

    {# Taslak JSON özniteliğe kaçışlanarak gömülür (autoescape) — betik etiketi içine değil. #}
    <div id="duzenleyici"
         data-taslak="{{ taslak|json_encode }}"
         data-planlar="{{ planlar|json_encode }}"
         data-kaydet="{{ path('panel_huni_taslak', {app: uygulama}) }}"
         data-jeton="{{ csrf_token('huni-' ~ uygulama) }}">
        <p class="soluk">Düzenleyici yükleniyor…</p>
    </div>

    <h2>Sürümler</h2>
    <div class="tablo">
        <table data-bolum="surumler">
            <thead><tr><th>Sürüm</th><th>Yayın (UTC)</th><th>Ziyaret</th><th></th></tr></thead>
            <tbody>
                {% for s in surumler %}
                    <tr>
                        <td>v{{ s.surum }}{% if loop.first %} <span class="odedi">yayında</span>{% endif %}</td>
                        <td>{{ s.zaman|date('Y-m-d H:i', 'UTC') }}</td>
                        <td>{{ s.ziyaret }}</td>
                        <td>
                            <form method="post" action="{{ path('panel_huni_geri_yukle', {app: uygulama, surum: s.surum}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('huni-' ~ uygulama) }}">
                                <button type="submit">Taslağa geri yükle</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="4" class="soluk">Henüz yayın yok.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <script src="/varliklar/huni-duzenleyici.js?v={{ duzenleyici_surumu }}" defer></script>
{% endblock %}
