{% extends 'base.html.twig' %}

{% block body %}
    <header>
        <h1>MyWeb2Wave panel</h1>
        <nav>
            {% for g in gunler %}
                {% if g == gun %}<strong>Son {{ g }} gün</strong>{% else %}<a href="{{ path('panel', {gun: g}) }}">Son {{ g }} gün</a>{% endif %}
            {% endfor %}
            <a href="{{ path('panel_huniler') }}">Huniler</a>
            <a href="{{ path('panel_cikis') }}">Çıkış</a>
        </nav>
    </header>

    <section class="kartlar">
        {% for ad, s in sayimlar %}
            <div class="kart" data-kaynak="{{ ad }}">
                <h2>{{ ad == 'reklam' ? 'Reklamdan gelen' : 'Organik / doğrudan' }}</h2>
                <dl>
                    <dt>Sayfayı gördü</dt><dd>{{ s.ziyaret }}</dd>
                    <dt>Ödemeye geçti</dt><dd>{{ s.odemeye_gecti }}</dd>
                    <dt>Ödedi</dt><dd>{{ s.odedi }}</dd>
                    <dt>Dönüşüm</dt><dd>{{ s.ziyaret > 0 ? ((s.odedi / s.ziyaret * 100)|number_format(1, ',') ~ ' %') : '—' }}</dd>
                </dl>
            </div>
        {% endfor %}
    </section>

    {% if adimlar is not empty %}
        <section class="kartlar">
            <div class="kart" data-bolum="adimlar">
                <h2>Anket adımları — kaç ziyaret ulaştı</h2>
                <table>
                    <thead><tr><th>Huni</th><th>#</th><th>Adım</th><th>Ulaşan</th><th>İlk adıma göre</th></tr></thead>
                    <tbody>
                        {% set ilk = {} %}
                        {% for a in adimlar %}
                            {% set anahtar = a.app ~ '/' ~ a.huni %}
                            {% if ilk[anahtar] is not defined %}{% set ilk = ilk|merge({(anahtar): a.ulasan}) %}{% endif %}
                            <tr>
                                <td>{{ a.huni }}{% if a.app != 'keepchat' %} <span class="soluk">({{ a.app }})</span>{% endif %}</td>
                                <td>{{ a.sira + 1 }}</td>
                                <td>{{ a.adim }}</td>
                                <td>{{ a.ulasan }}</td>
                                <td>{{ (a.ulasan / ilk[anahtar] * 100)|number_format(0, ',') }} %</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="kart" data-bolum="cevaplar">
                <h2>Cevaplar</h2>
                <table>
                    <thead><tr><th>Soru</th><th>Cevap</th><th>Sayı</th></tr></thead>
                    <tbody>
                        {% for c in cevaplar %}
                            <tr><td>{{ c.soru }}</td><td>{{ c.secenek }}</td><td>{{ c.sayi }}</td></tr>
                        {% else %}
                            <tr><td colspan="3" class="soluk">Henüz cevap yok.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    {% endif %}

    <div class="tablo">
        <table>
            <thead>
                <tr><th>Zaman (UTC)</th><th>Uygulama</th><th>Huni</th><th>Kaynak</th><th>Kampanya</th><th>Aşama</th><th>Abonelik</th><th>E-posta</th></tr>
            </thead>
            <tbody>
                {% for s in satirlar %}
                    <tr>
                        <td>{{ s.zaman|date('Y-m-d H:i', 'UTC') }}</td>
                        <td>{{ s.app }}</td>
                        <td>{{ s.huni ?? '—' }}</td>
                        <td>{% if s.reklam %}<span class="reklam">reklam</span> · {% endif %}{{ s.kaynak }}</td>
                        <td>{{ s.kampanya ?? '—' }}</td>
                        <td{% if s.asama == 'ödedi' %} class="odedi"{% endif %}>{{ s.asama }}</td>
                        <td>{{ s.durum ?? '—' }}</td>
                        <td>{{ s.email ?? '—' }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="8" class="soluk">Bu aralıkta ziyaret yok.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% if satirlar|length == azami %}<p class="soluk">En yeni {{ azami }} ziyaret gösteriliyor; sayımlar tüm aralığı kapsar.</p>{% endif %}
{% endblock %}
