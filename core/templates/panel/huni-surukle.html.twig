{# Sürükle-bırak düzenleyici (E2.4): Puck tam ekran. Taslak özniteliğe
   kaçışlanarak gömülür (autoescape); doğrulama çekirdekte. #}
<!DOCTYPE html>
<html lang="tr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="robots" content="noindex, nofollow">
        <title>{{ uygulama }}/{{ huni }} · sürükle-bırak · MyWeb2Wave panel</title>
        {% for s in stiller %}<link rel="stylesheet" href="{{ s }}">{% endfor %}
        <style>
            body { margin: 0; font: 15px/1.45 system-ui, sans-serif; }
            .puck-ust { display: flex; flex-wrap: wrap; gap: 12px; padding: 8px 12px; font-size: 14px; border-bottom: 1px solid #8884; }
            .puck-durum { position: fixed; z-index: 1000; right: 16px; bottom: 16px; max-width: 420px; padding: 12px 36px 12px 12px; border-radius: 8px; background: #fff; color: #111; box-shadow: 0 4px 20px #0003; }
            .puck-durum.hata { border-left: 4px solid #cf222e; }
            .puck-durum.tamam { border-left: 4px solid #1a7f37; }
            .puck-durum ul { margin: 6px 0 0; padding-left: 18px; }
            .puck-durum button { position: absolute; top: 6px; right: 8px; border: 0; background: none; font-size: 18px; cursor: pointer; }
            .puck-ust-cubuk { display: flex; align-items: center; gap: 8px; font-size: 14px; }
            .puck-ust-cubuk button, .puck-dugme { font: inherit; padding: 6px 12px; border-radius: 6px; border: 1px solid #8886; background: #fff; color: #111; cursor: pointer; text-decoration: none; }
            .puck-ust-cubuk .ana { background: #1a7f37; border-color: #1a7f37; color: #fff; }
            .puck-ust-cubuk :disabled, .puck-dugme[aria-disabled=true] { opacity: .45; cursor: not-allowed; pointer-events: none; }
            .puck-not { display: inline-flex; align-items: center; gap: 7px; padding: 6px 10px; border-radius: 999px; background: #f6f8fa; color: #57606a; font-size: 13px; font-weight: 600; }
            .puck-not::before { content: ""; width: 8px; height: 8px; flex: 0 0 8px; border-radius: 50%; background: currentColor; }
            .puck-not-kaydedilmemis { background: #fff8c5; color: #7d4e00; }
            .puck-not-taslak { background: #ddf4ff; color: #0969a3; }
            .puck-not-uyari { background: #ffebe9; color: #a40e26; }
            .puck-not-yayinlandi { background: #dafbe1; color: #1a7f37; }
            .puck-not-bilinmiyor, .puck-not-mesgul { background: #f6f8fa; color: #57606a; }
            .puck-surumler { position: relative; }
            .puck-surumler summary { cursor: pointer; padding: 6px 4px; }
            .puck-surumler ul { position: absolute; right: 0; z-index: 1000; min-width: 380px; margin: 4px 0 0; padding: 8px; list-style: none; background: #fff; color: #111; border-radius: 8px; box-shadow: 0 4px 20px #0003; }
            .puck-surumler li { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 4px 0; }
            @media (max-width: 760px) {
                #puck-duzenleyici { flex: 1 1 100%; min-width: 0; }
                .puck-ust-cubuk { flex-wrap: wrap; width: 100%; }
                .puck-not { flex: 1 0 100%; }
                .puck-ust-cubuk button, .puck-dugme { min-height: 40px; }
                .puck-surumler ul { position: fixed; left: 20px; right: 20px; min-width: 0; width: auto; max-height: 65vh; overflow: auto; }
                .puck-surumler li { flex-wrap: wrap; }
            }
            @media (max-width: 420px) {
                .puck-ust-cubuk { gap: 6px; }
                .puck-ust-cubuk button, .puck-dugme { padding: 6px 8px; }
                .puck-surumler { flex-basis: 100%; }
                .puck-surumler ul { left: 12px; right: 12px; width: auto; }
            }
        </style>
    </head>
    <body>
        <nav class="puck-ust">
            <a href="{{ path('panel_huniler') }}">← Huniler ve kurallar</a>
        </nav>
        <div id="puck-duzenleyici"
             data-taslak="{{ taslak|json_encode }}"
             data-planlar="{{ planlar|json_encode }}"
             data-tema-varsayilan="{{ tema_varsayilan|json_encode }}"
             data-yazi-tipleri="{{ yazi_tipleri|json_encode }}"
             data-kaydet="{{ path('panel_huni_taslak', {app: uygulama, ad: huni}) }}"
             data-durum="{{ path('panel_huni_durum', {app: uygulama, ad: huni}) }}"
             data-medya="{{ path('panel_medya_liste', {app: uygulama}) }}"
             data-jeton="{{ csrf_token('huni-' ~ uygulama) }}"
             data-imza="{{ imza }}"
             data-baslik="{{ uygulama }} · {{ huni }}"></div>
        <script type="module" src="{{ betik }}"></script>
    </body>
</html>
