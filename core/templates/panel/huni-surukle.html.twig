{# Sürükle-bırak düzenleyici (E2.4): Puck tam ekran. Taslak özniteliğe
   kaçışlanarak gömülür (autoescape); doğrulama çekirdekte. #}
<!DOCTYPE html>
<html lang="tr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="robots" content="noindex, nofollow">
        <title>{{ uygulama }}/{{ huni }} · sürükle-bırak · MyWeb2Wave panel</title>
        {% for s in stiller %}<link rel="stylesheet" href="{{ s }}">{% endfor %}
        <style>
            body { margin: 0; font: 15px/1.45 system-ui, sans-serif; }
            .puck-ust { display: flex; gap: 12px; padding: 8px 12px; font-size: 14px; border-bottom: 1px solid #8884; }
            .puck-durum { position: fixed; z-index: 1000; right: 16px; bottom: 16px; max-width: 420px; padding: 12px 36px 12px 12px; border-radius: 8px; background: #fff; color: #111; box-shadow: 0 4px 20px #0003; }
            .puck-durum.hata { border-left: 4px solid #cf222e; }
            .puck-durum.tamam { border-left: 4px solid #1a7f37; }
            .puck-durum ul { margin: 6px 0 0; padding-left: 18px; }
            .puck-durum button { position: absolute; top: 6px; right: 8px; border: 0; background: none; font-size: 18px; cursor: pointer; }
        </style>
    </head>
    <body>
        <nav class="puck-ust">
            <a href="{{ path('panel_huni', {app: uygulama, ad: huni}) }}">← Klasik düzenleyici, yayınla ve sürümler</a>
            <span>"Publish" = taslağı kaydet (yayın panelden)</span>
        </nav>
        <div id="puck-duzenleyici"
             data-taslak="{{ taslak|json_encode }}"
             data-planlar="{{ planlar|json_encode }}"
             data-tema-varsayilan="{{ tema_varsayilan|json_encode }}"
             data-yazi-tipleri="{{ yazi_tipleri|json_encode }}"
             data-kaydet="{{ path('panel_huni_taslak', {app: uygulama, ad: huni}) }}"
             data-medya="{{ path('panel_medya_liste', {app: uygulama}) }}"
             data-jeton="{{ csrf_token('huni-' ~ uygulama) }}"
             data-baslik="{{ uygulama }} · {{ huni }}"></div>
        <script type="module" src="{{ betik }}"></script>
    </body>
</html>
