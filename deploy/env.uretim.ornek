# Sunucuda deploy/.env.uretim olarak kopyala, doldur, `chmod 600`.
# Gerçek dosya git dışı; bu örnekte değer YOK.
# Rastgele değer: openssl rand -hex 32

API_ALANI=api.ornek.com
HUNI_ALANI=abone.ornek.com

POSTGRES_PASSWORD=
APP_SECRET=

# Test modu (C6): yalnız sk_test_ kabul edilir, dagit.sh denetler.
STRIPE_SECRET_KEY=
# M2d: gömülü ödeme; boşsa Stripe sayfasına yönlendirme (çalışır, gömülü değil).
STRIPE_PUBLISHABLE_KEY=
# Stripe panelinde (test) https://<API_ALANI>/webhooks/stripe uç noktası
# açıldığında verilen whsec_ — yerel `stripe listen` sırrı DEĞİL.
STRIPE_WEBHOOK_SECRET=

# Gerçek e-posta sağlayıcısının SMTP'si (Ç30), ör. smtp://kullanici:sifre@smtp.saglayici.com:587
MAILER_DSN=
MAIL_GONDEREN=no-reply@ornek.com

# KeepChat sunucusundaki değerle aynı.
UYGULAMA_ANAHTARI_KEEPCHAT=

# İç panel: https://<API_ALANI>/panel. Özet (düz şifre değil):
#   docker compose -f deploy/compose.yaml run --rm core php bin/console security:hash-password
# ⚠️ TEK TIRNAK içinde yaz — özetteki $ işaretleri yoksa sessizce bozulur (tuzak §26).
PANEL_KULLANICI=
PANEL_SIFRE_OZETI=''

# Hak kaynağı RevenueCat (A9): RevenueCat → Project → Apps → Stripe uygulamasının
# AÇIK API anahtarı. Boş = aktarım kapalı.
REVENUECAT_STRIPE_KEEPCHAT=

# H6: TikTok piksel kimliği web imajına herkese açık değer olarak derlenir;
# erişim anahtarları yalnız çekirdek sunucusunda kalır. A30: Meta (Pixel, CAPI,
# reklam hesabı) panelden — Entegrasyonlar › Meta; burada yalnız sürüm.
META_GRAPH_API_VERSION=v24.0
# A30: panelden girilen anahtarların şifreleme anahtarı. Bir kez üret, sakla:
# php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'  — değişirse panelde yeniden girilir.
AYAR_SIFRELEME_ANAHTARI=
TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=
TIKTOK_TEST_EVENT_CODE=

# V3b: stok fotoğraf — Pexels hesabından API anahtarı (https://www.pexels.com/api/).
# Boş = panelde stok arama yok, AI aracı kapalı.
PEXELS_API_KEY=
