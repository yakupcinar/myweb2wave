---
// KeepChat hunisi (A4: her uygulamanın kendi yolu): anket + tanıtım, sonda
// paywall. Adımlar src/huniler/keepchat.ts'te; motor components/Huni.astro.
// Açılışta hangi reklamdan gelindiği, her adım ve cevap çekirdeğe yazılır
// (A6); çerez ya da tarayıcı deposu yok.
import Huni from "../../components/Huni.astro";
import { keepchat } from "../../huniler/keepchat";
---

<Huni huni={keepchat}>
  <div slot="paywall">
    <h1 tabindex="-1">KeepChat Pro</h1>
    <p>
      Aylık plan · <strong>9,99 € / ay</strong>
    </p>
    <button id="abone-ol" class="ana" type="button" data-plan="monthly">
      Abone ol
    </button>
    <p id="hata" role="alert" hidden></p>
  </div>
</Huni>
