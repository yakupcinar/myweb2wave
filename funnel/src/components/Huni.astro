---
// Huni motoru: tanımdaki adımları TEK SAYFADA sırayla gösterir (kullanıcı
// kararı 2026-10-20). Sayfa yeniden yüklenmez → ziyaret kimliği bellekte
// kalır, çerez gerekmez. Tarayıcının geri tuşu bir önceki adıma döner.
// Paywall'ın içeriği "paywall" yuvasından gelir; içinde data-plan'lı
// #abone-ol düğmesi ve #hata paragrafı olmalı.
import type { Huni } from "../huniler/tipler";

interface Props {
  huni: Huni;
}
const { huni } = Astro.props;

// Tanım hatası derlemeyi durdurur: çekirdek bu biçimi 422 ile reddeder,
// panelde adım sessizce eksik kalırdı.
const KIMLIK = /^[a-z0-9_-]{1,64}$/;
const gorulen = new Set<string>();
huni.adimlar.forEach((adim, sira) => {
  if (!KIMLIK.test(adim.id) || gorulen.has(adim.id)) {
    throw new Error(
      `Huni ${huni.app}: geçersiz ya da tekrar eden adım kimliği "${adim.id}"`,
    );
  }
  gorulen.add(adim.id);
  if (adim.tur === "soru") {
    const secenekler = new Set<string>();
    for (const s of adim.secenekler) {
      if (!KIMLIK.test(s.id) || secenekler.has(s.id)) {
        throw new Error(
          `Huni ${huni.app}/${adim.id}: geçersiz ya da tekrar eden seçenek "${s.id}"`,
        );
      }
      secenekler.add(s.id);
    }
  }
  if ((adim.tur === "paywall") !== (sira === huni.adimlar.length - 1)) {
    throw new Error(`Huni ${huni.app}: paywall tam bir kez ve EN SONDA olmalı`);
  }
});
const toplam = huni.adimlar.length;
---

<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{huni.sayfaBasligi}</title>
    <!-- Global: bileşen stili kapsamlıdır ve yuvadan gelen paywall
         öğelerine UYGULANMAZ (tarayıcıda ölçüldü: düğme stilsiz kaldı).
         Huni sayfanın tamamı, global stil burada güvenli. -->
    <style is:global>
      body {
        font:
          17px/1.5 system-ui,
          sans-serif;
        margin: 0 auto;
        padding: 16px;
        max-width: 520px;
      }
      progress {
        width: 100%;
        height: 6px;
      }
      .secenekler {
        display: grid;
        gap: 10px;
      }
      button {
        font: inherit;
        padding: 12px 16px;
        border-radius: 10px;
        border: 1px solid #8886;
        background: transparent;
        color: inherit;
        text-align: left;
        cursor: pointer;
      }
      button.ana {
        background: #2563eb;
        color: #fff;
        border-color: #2563eb;
        text-align: center;
        width: 100%;
      }
    </style>
  </head>
  <body>
    <main data-huni-app={huni.app}>
      <progress id="ilerleme" max={toplam} value="1"></progress>
      {huni.adimlar.map((adim, sira) => (
        <section data-adim={adim.id} data-sira={sira} hidden={sira !== 0}>
          {adim.tur === "tanitim" && (
            <>
              <h1 tabindex="-1">{adim.baslik}</h1>
              <p>{adim.metin}</p>
              <button class="ana" type="button" data-ileri>
                {adim.dugme}
              </button>
            </>
          )}
          {adim.tur === "soru" && (
            <>
              <h1 tabindex="-1">{adim.soru}</h1>
              <div class="secenekler">
                {adim.secenekler.map((s) => (
                  <button type="button" data-secenek={s.id}>
                    {s.metin}
                  </button>
                ))}
              </div>
            </>
          )}
          {adim.tur === "paywall" && <slot name="paywall" />}
        </section>
      ))}
    </main>

    <script>
      import { cekirdek } from "../lib/cekirdek";
      import {
        ilerlemeBildir,
        ziyaretBaslat,
        type Govde,
      } from "../lib/ziyaret";

      const ana = document.querySelector<HTMLElement>("[data-huni-app]");
      const app = ana?.dataset["huniApp"] as Govde<"/huni/ziyaretler">["app"];
      const ziyaretSozu = ziyaretBaslat(app);

      const adimlar = [
        ...document.querySelectorAll<HTMLElement>("[data-adim]"),
      ];
      const cubuk = document.querySelector<HTMLProgressElement>("#ilerleme");
      let mevcut = 0;

      function goster(sira: number, gecmiseEkle: boolean): void {
        const adim = adimlar[sira];
        if (!adim) return;
        adimlar.forEach((a, i) => (a.hidden = i !== sira));
        mevcut = sira;
        if (cubuk) cubuk.value = sira + 1;
        if (gecmiseEkle) history.pushState({ adim: sira }, "");
        adim.querySelector<HTMLElement>("h1")?.focus();
        ilerlemeBildir(ziyaretSozu, sira, adim.dataset["adim"] ?? "");
      }

      // Geri tuşu bir önceki adıma döner, sayfadan çıkmaz.
      history.replaceState({ adim: 0 }, "");
      window.addEventListener("popstate", (e: PopStateEvent) => {
        const sira = (e.state as { adim?: number } | null)?.adim ?? 0;
        goster(sira, false);
      });
      ilerlemeBildir(ziyaretSozu, 0, adimlar[0]?.dataset["adim"] ?? "");

      for (const d of document.querySelectorAll<HTMLButtonElement>(
        "[data-ileri]",
      )) {
        d.addEventListener("click", () => goster(mevcut + 1, true));
      }
      for (const d of document.querySelectorAll<HTMLButtonElement>(
        "[data-secenek]",
      )) {
        d.addEventListener("click", () => {
          const soru = adimlar[mevcut]?.dataset["adim"] ?? "";
          ilerlemeBildir(ziyaretSozu, mevcut, soru, d.dataset["secenek"]);
          goster(mevcut + 1, true);
        });
      }

      // Paywall: plan adını çekirdeğe gönderir, dönen ödeme adresine yönlenir.
      const dugme = document.querySelector<HTMLButtonElement>("#abone-ol");
      const hata = document.querySelector<HTMLParagraphElement>("#hata");

      function hataGoster(metin: string): void {
        if (hata) {
          hata.textContent = metin;
          hata.hidden = false;
        }
        if (dugme) dugme.disabled = false;
      }

      dugme?.addEventListener("click", async () => {
        dugme.disabled = true;
        try {
          const govde: Govde<"/checkout/sessions"> = {
            app,
            plan: dugme.dataset["plan"] as Govde<"/checkout/sessions">["plan"],
          };
          const ziyaret = await ziyaretSozu;
          if (ziyaret) govde.ziyaret = ziyaret;
          const { data, error, response } = await cekirdek.POST(
            "/checkout/sessions",
            { body: govde },
          );
          if (data) {
            window.location.assign(data.url);
            return;
          }
          hataGoster(
            response.status === 502 &&
              error?.error === "payment_provider_unavailable"
              ? "Ödeme sağlayıcısına şu an ulaşılamıyor. Lütfen biraz sonra tekrar deneyin."
              : "Bir şeyler ters gitti. Lütfen tekrar deneyin.",
          );
        } catch {
          // Ağ hatası: çekirdeğe hiç ulaşılamadı.
          hataGoster(
            "Bağlantı kurulamadı. İnternetinizi kontrol edip tekrar deneyin.",
          );
        }
      });
    </script>
  </body>
</html>
