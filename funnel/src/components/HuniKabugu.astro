---
// Huni kabuğu (A7, B4/H2): statik HTML + tek React adacığı (Huni.tsx).
// İçerik çalışma anında geldiği için sunucuda çizilecek veri yok →
// client:only. Tanım isteği satır içi betikle HTML ayrıştırılırken başlar,
// oynatıcının JS'ini beklemez (H0 bulgusu; erken-istek.ts).
// Görünüm ve tema formülü panel düzenleyicisiyle ortak (B4/H1).
import "../../../huni-bilesenleri/huni.css";
import Huni from "../oynatici/Huni";
import { tanimIstegi } from "../oynatici/erken-istek";

interface Props {
  app: "keepchat";
}
const { app } = Astro.props;
// Değerler sabit (uygulama adı, derlemedeki çekirdek adresi) — JSON ile kaçışlanır.
const erken = `window.huniTanimi=(${tanimIstegi.toString()})(${JSON.stringify(app)},${JSON.stringify(import.meta.env.PUBLIC_CORE_URL)});`;
---

<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Yükleniyor…</title>
    <script is:inline set:html={erken} />
  </head>
  <body class="huni">
    <main>
      <Huni client:only="react" app={app}>
        <p id="durum" slot="fallback">
          Yükleniyor…
        </p>
      </Huni>
    </main>
  </body>
</html>
